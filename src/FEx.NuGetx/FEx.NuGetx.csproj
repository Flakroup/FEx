<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>$(StandardTargetFrameworkIds)</TargetFrameworks>
		<Description>NuGet package management utilities with package discovery and installation tracking</Description>
	</PropertyGroup>
	<!-- NuGet client 7.x dropped netstandard2.0; 6.14.x is the last line that ships it. -->
	<PropertyGroup>
		<NuGetClientVersion>6.14.3</NuGetClientVersion>
		<NuGetClientVersion Condition="'$(TargetFramework)' == '$(TargetFrameworkId)'">7.6.0</NuGetClientVersion>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="NuGet.Protocol" Version="$(NuGetClientVersion)" />
		<PackageReference Include="NuGet.Packaging" Version="$(NuGetClientVersion)" />
		<PackageReference Include="NuGet.Common" Version="$(NuGetClientVersion)" />
		<!-- Security pin (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx): NuGet.Packaging transitively pulls
		     System.Security.Cryptography.Pkcs 8.0.1 / 9.0.18, which the advisories flag (fixed in 8.0.2 / 9.0.21 /
		     10.0.13). Remove once NuGet.Packaging pulls a patched version. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="$(DotNetNugetsVersion)" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="FEx.NuGetx.Tests" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Agnostics.Abstractions\FEx.Agnostics.Abstractions.csproj" />
		<ProjectReference Include="..\Agnostics\FEx.Agnostics.csproj" />
		<ProjectReference Include="..\DependencyInjection.Abstractions\FEx.DependencyInjection.Abstractions.csproj" />
		<ProjectReference Include="..\FEx.Asyncx\FEx.Asyncx.csproj" />
	</ItemGroup>
</Project>

