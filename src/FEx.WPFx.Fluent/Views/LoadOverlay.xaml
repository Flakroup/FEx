<UserControl x:Class="FEx.WPFx.Fluent.Views.LoadOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sits over the data area of a tab and stands in for the grid whenever there are no rows to show. Opaque, so
         the empty grid underneath never shows through. -->
    <Grid Background="{DynamicResource Surface}">
        <!-- Loading: six skeleton bars, then the sentence. -->
        <StackPanel x:Name="pnlLoading" VerticalAlignment="Top" Margin="16,24,16,0">
            <Border Height="14" Margin="0,0,0,12" CornerRadius="3" Background="{DynamicResource Line2}" />
            <Border Height="14" Margin="0,0,60,12" CornerRadius="3" Background="{DynamicResource Line2}" />
            <Border Height="14" Margin="0,0,20,12" CornerRadius="3" Background="{DynamicResource Line2}" />
            <Border Height="14" Margin="0,0,90,12" CornerRadius="3" Background="{DynamicResource Line2}" />
            <Border Height="14" Margin="0,0,40,12" CornerRadius="3" Background="{DynamicResource Line2}" />
            <Border Height="14" Margin="0,0,70,16" CornerRadius="3" Background="{DynamicResource Line2}" />
            <TextBlock x:Name="lblLoading" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Empty, database unreachable, database not configured: a centred message and, where it helps, buttons. -->
        <StackPanel x:Name="pnlMessage" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24"
                    Visibility="Collapsed">
            <TextBlock x:Name="lblTitle" FontSize="15" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource Ink}" />
            <TextBlock x:Name="lblHint" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource Muted}" />
            <StackPanel x:Name="pnlButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button x:Name="btnRetry" Padding="14,4" Margin="0,0,8,0" Click="BtnRetry_Click" />
                <Button x:Name="btnSettings" Padding="14,4" Click="BtnSettings_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
