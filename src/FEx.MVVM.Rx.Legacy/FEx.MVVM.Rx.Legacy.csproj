<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(StandardTargetFrameworkIds)</TargetFrameworks>
		<Description>Legacy ReactiveUI-based MVVM module (ReactiveUI 22.x, netstandard2.0/2.1 + net10.0) for consumers that cannot migrate to ReactiveUI 23.x / Avalonia 12 (WPF, netstandard)</Description>
		<RootNamespace>FEx.MVVM.Rx.Legacy</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ReactiveUI" Version="22.2.1" />
		<PackageReference Include="StrongInject.Extensions.DependencyInjection" Version="1.4.4" />
		<PackageReference Include="System.Text.Json" Version="$(DotNetNugetsVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Common.Abstractions\FEx.Common.Abstractions.csproj" />
		<ProjectReference Include="..\DependencyInjection.Abstractions\FEx.DependencyInjection.Abstractions.csproj" />
		<ProjectReference Include="..\FEx.MVVM.Abstractions\FEx.MVVM.Abstractions.csproj" />
	</ItemGroup>

</Project>
