<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
        <TargetFrameworks>$(StandardTargetFrameworkIds)</TargetFrameworks>
		<Description>Entity Framework Core helpers for DbContext configuration, bulk operations, and resilient transactions</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="EFCore.BulkExtensions" Version="$(BulkExtensionsVersion)" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EFCoreVersion)" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EFCoreVersion)" />
		<!-- Security pin (GHSA-2m69-gcr7-jv3q): EntityFrameworkCore.Sqlite transitively pulls the bundled
		     native SQLitePCLRaw.lib.e_sqlite3 2.1.11, which the advisory flags (vulnerable range <= 2.1.11,
		     no managed-side patched version). 3.50.3 versions the native engine by SQLite version (3.50.3),
		     is outside the vulnerable range, and carries no managed dependencies (ABI-stable, independent of
		     SQLitePCLRaw.core/provider). Remove once EntityFrameworkCore.Sqlite ships a non-vulnerable bundle. -->
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(EFCoreVersion)" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="$(EFCoreVersion)">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="$(DotNetNugetsVersion)" />
		<PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
		<PackageReference Include="System.Formats.Asn1" Version="$(DotNetNugetsVersion)" />
		<PackageReference Include="System.Text.Json" Version="$(DotNetNugetsVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FEx.Asyncx\FEx.Asyncx.csproj" />
		<ProjectReference Include="..\Core\FEx.Core.csproj" />
		<ProjectReference Include="..\FEx.Json\FEx.Json.csproj" />
		<ProjectReference Include="..\Sqlx.Abstractions\FEx.Sqlx.Abstractions.csproj" />
	</ItemGroup>

</Project>
