<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(StandardTargetFrameworkIds)</TargetFrameworks>
		<Description>ReactiveUI-based MVVM module with reactive base objects, observable progress, and linked properties</Description>
	</PropertyGroup>

	<ItemGroup>
		<!-- ReactiveUI 23 ships no netstandard2.0 asset and 22.x lacks the RxAppBuilder API this module is written against,
		     so netstandard2.0 consumers get the net462 asset. Suppressed for ReactiveUI and its Splat dependencies only (NoWarn flows to dependents). -->
		<PackageReference Include="ReactiveUI" Version="23.2.28" NoWarn="NU1701" />
		<PackageReference Include="Splat" Version="19.4.1" NoWarn="NU1701" />
		<PackageReference Include="Splat.Builder" Version="19.4.1" NoWarn="NU1701" />
		<PackageReference Include="Splat.Core" Version="19.4.1" NoWarn="NU1701" />
		<PackageReference Include="Splat.Logging" Version="19.4.1" NoWarn="NU1701" />
		<PackageReference Include="StrongInject.Extensions.DependencyInjection" Version="1.4.4" />
		<PackageReference Include="System.Text.Json" Version="$(DotNetNugetsVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Common.Abstractions\FEx.Common.Abstractions.csproj" />
		<ProjectReference Include="..\DependencyInjection.Abstractions\FEx.DependencyInjection.Abstractions.csproj" />
		<ProjectReference Include="..\FEx.MVVM.Abstractions\FEx.MVVM.Abstractions.csproj" />
	</ItemGroup>

</Project>
