<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(StandardTargetFrameworkIds)</TargetFrameworks>
		<Description>Opt-in Newtonsoft.Json serializer for FEx.Flurlx (replaces the default System.Text.Json serializer). Reference this and register FExFlurlxNewtonsoftModule instead of FExFlurlxModule.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Flurl.Http.Newtonsoft" Version="0.9.1" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="StrongInject" Version="1.4.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FEx.Flurlx\FEx.Flurlx.csproj" />
		<ProjectReference Include="..\FEx.Json\FEx.Json.csproj" />
	</ItemGroup>

</Project>
