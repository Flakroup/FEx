<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(WindowsTargetFrameworkId)</TargetFramework>
		<Description>Test helpers for FEx.WPFx.Fluent views: an STA runner and a message-only presentation host, so WPF tests never show a window</Description>
		<UseWPF>true</UseWPF>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3.assert" Version="4.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WPFx.Fluent\FEx.WPFx.Fluent.csproj" />
	</ItemGroup>

</Project>
