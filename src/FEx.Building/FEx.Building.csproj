<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>Shared NUKE build components (FExBuild, compile/test/pack/tag/GitVersion targets) for consuming repositories that build via packages instead of a submodule</Description>
        <Configurations>Debug;Release;Build</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotNetNugetsVersion)" />
        <PackageReference Include="Microsoft.VisualStudio.Threading" Version="18.7.23" />
        <PackageReference Include="Nuke.Common" Version="10.1.0" />
        <PackageReference Include="Nuke.Utilities" Version="10.1.0" />
        <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    </ItemGroup>

</Project>
