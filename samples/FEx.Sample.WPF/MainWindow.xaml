<Window x:Class="FEx.Sample.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FEx Sample - Multi-DI Demo" Height="350" Width="525">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,20">
                FEx Multi-DI Sample
            </TextBlock>

            <TextBlock FontSize="16" TextAlignment="Center" Margin="0,0,0,10">
                This WPF app uses StrongInject-only pattern
            </TextBlock>

            <TextBlock TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20">
                ✅ StrongInject: Base DI (always on)
                <LineBreak/>
                ⚪ Microsoft DI: Not needed for WPF
                <LineBreak/>
                🚀 Engine-Agnostic: Ready for any DI engine
            </TextBlock>

            <Button x:Name="testButton" Content="Test FEx Logging" 
                    Click="TestButton_Click" 
                    Padding="10" 
                    FontSize="14"
                    HorizontalAlignment="Center"/>

            <TextBlock x:Name="statusText" 
                       TextAlignment="Center" 
                       Margin="0,20,0,0" 
                       FontStyle="Italic"
                       Foreground="Green"/>
        </StackPanel>
    </Grid>
</Window>
