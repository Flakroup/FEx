<Project>

    <Import Project="$(MSBuildThisFileDirectory)DevConfigs\Directory.Build.targets"/>

    <PropertyGroup>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageIcon>flakroup.png</PackageIcon>
        <WarnOnPackingNonPackableProject>true</WarnOnPackingNonPackableProject>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/Flakroup/FEx</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Flakroup/FEx.git</RepositoryUrl>
        <PackageTags>dotnet;utilities;extensions;fex;flakroup</PackageTags>
    </PropertyGroup>

    <!-- FEx.Analyzers runs on every other project from source, its rules at error through DevConfigs'
         FEx.Analyzers.globalconfig. The analyzer project and its tests are the only exclusions: the analyzer cannot analyze
         itself before it is built, and the tests reference it as an ordinary library to drive it.
         OutputItemType="Analyzer" is what makes the compiler run it; ReferenceOutputAssembly="false" is what keeps it out of
         a packed nuspec (restore drops such a reference, so no FEx.Analyzers dependency is written). Both are pinned by
         OwnAnalyzerWiringTests. -->
    <ItemGroup Condition=" '$(MSBuildProjectName)' != 'FEx.Analyzers' And '$(MSBuildProjectName)' != 'FEx.Analyzers.Tests' ">
        <ProjectReference Include="$(MSBuildThisFileDirectory)src/Analyzers/FEx.Analyzers.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup Condition=" '$(IsPackable)' != 'false' ">
        <None Include="$(MSBuildThisFileDirectory)\flakroup.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
    </ItemGroup>

</Project>