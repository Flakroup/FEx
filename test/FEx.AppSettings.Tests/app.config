<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<add key="Legacy.Name" value="from-app-config" />
		<add key="Legacy.Enabled" value="true" />
		<add key="Legacy.Disabled" value="FALSE" />
		<add key="Legacy.Broken" value="maybe" />
		<add key="Legacy.Port" value="8080" />
	</appSettings>
	<connectionStrings>
		<add name="Main" connectionString="Server=legacy;Database=main" />
	</connectionStrings>
</configuration>
