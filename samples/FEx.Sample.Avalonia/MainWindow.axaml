<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:FEx.Sample.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="FEx.Sample.Avalonia.MainWindow"
        x:DataType="avalonia:MainWindowViewModel"
        Title="FEx Sample - Avalonia + Flurlx Demo" Width="900" Height="700">

    <Grid Margin="20" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#1976D2">
                🚀 FEx Multi-DI Sample
            </TextBlock>
            <TextBlock FontSize="16" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="#616161">
                Avalonia + Flurlx + Polly Resilience
            </TextBlock>
        </StackPanel>

        <!-- Architecture Info -->
        <Border Grid.Row="1" Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" Padding="15" CornerRadius="8" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock FontWeight="Bold" FontSize="14" Foreground="#0D47A1">Architecture:</TextBlock>
                <TextBlock Margin="0,5,0,0" Foreground="#424242">
                    ✅ StrongInject: Base DI (always on)
                </TextBlock>
                <TextBlock Foreground="#424242">
                    ⚡ Avalonia: Cross-platform UI framework
                </TextBlock>
                <TextBlock Foreground="#424242">
                    🌐 Flurlx: HTTP client with Polly resilience
                </TextBlock>
                <TextBlock Foreground="#424242">
                    🔄 Polly: Retry, Circuit Breaker, Timeout, Bulkhead
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,0,0,20">
            <Button Command="{Binding LoadUsersCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Padding="15,10"
                    FontSize="14"
                    Background="#1976D2"
                    Foreground="White">
                👥 Load Users
            </Button>
            <Button Command="{Binding LoadPostsCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Padding="15,10"
                    FontSize="14"
                    Background="#1976D2"
                    Foreground="White">
                📝 Load Posts
            </Button>
            <Button Command="{Binding TestResilienceCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Padding="15,10"
                    FontSize="14"
                    Background="#1976D2"
                    Foreground="White">
                🛡️ Test Resilience
            </Button>
        </StackPanel>

        <!-- Status -->
        <Border Grid.Row="3" Background="#E8F5E9" Padding="10" CornerRadius="5" Margin="0,0,0,15">
            <TextBlock Text="{Binding StatusText}"
                       FontStyle="Italic"
                       Foreground="#2E7D32"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Users List -->
        <Border Grid.Row="4" Background="White" BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#1976D2">
                    Users:
                </TextBlock>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8" Margin="0,0,0,5" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Text="{Binding Name}" Foreground="#212121"/>
                                        <TextBlock FontSize="12" Foreground="#757575" Text="{Binding Email}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Posts List -->
        <Border Grid.Row="5" Background="White" BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="5" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#1976D2">
                    Posts (Top 10):
                </TextBlock>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Posts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8" Margin="0,0,0,5" CornerRadius="3">
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" Text="{Binding Title}" Foreground="#212121"/>
                                        <TextBlock FontSize="12" Foreground="#757575" Text="{Binding Body}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>

