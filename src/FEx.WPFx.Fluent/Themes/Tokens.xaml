<!-- Light colour tokens. Views reference these only as {DynamicResource Name}, never a hex literal.
     Tokens.Dark.xaml and Tokens.HighContrast.xaml define the same keys (ThemeTokensTests).
     ContentControlThemeFontFamily is the classic Segoe UI, not Fluent's Segoe UI Variable: every Fluent control
     template takes its font from this key, and every variant carries it so a theme switch never drops it. A window
     binds its own FontFamily to it with {DynamicResource ContentControlThemeFontFamily}. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI</FontFamily>
    <SolidColorBrush x:Key="Bg" Color="#F4F6F9" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ink" Color="#18202B" />
    <SolidColorBrush x:Key="Muted" Color="#566070" />
    <SolidColorBrush x:Key="Faint" Color="#8A93A2" />
    <SolidColorBrush x:Key="Line" Color="#DCE1E8" />
    <SolidColorBrush x:Key="Line2" Color="#EEF1F5" />
    <SolidColorBrush x:Key="CtrlLine" Color="#C9D0DA" />
    <SolidColorBrush x:Key="InputLine" Color="#8C96A5" />
    <SolidColorBrush x:Key="Accent" Color="#1D5BBF" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#E8F0FC" />
    <SolidColorBrush x:Key="AccentInk" Color="#123F86" />
    <SolidColorBrush x:Key="DangerButton" Color="#B3261E" />
    <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Danger" Color="#B3261E" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FCEBEA" />
    <SolidColorBrush x:Key="WarnSoft" Color="#FFF3DC" />
    <SolidColorBrush x:Key="WarnInk" Color="#7A4B00" />
    <SolidColorBrush x:Key="WarnBar" Color="#C98A00" />
    <SolidColorBrush x:Key="Ok" Color="#17703F" />
    <SolidColorBrush x:Key="OkSoft" Color="#E7F4EC" />
    <SolidColorBrush x:Key="DisabledBg" Color="#EEF1F5" />
    <SolidColorBrush x:Key="DisabledInk" Color="#6B7482" />
    <SolidColorBrush x:Key="HeadBg" Color="#F4F6F9" />
    <SolidColorBrush x:Key="HeadInk" Color="#3A4352" />
    <SolidColorBrush x:Key="RowLine" Color="#F0F2F5" />
    <SolidColorBrush x:Key="OverlayHead" Color="#18202B" />
    <SolidColorBrush x:Key="OnOverlayHead" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayScrim" Color="#D90A0E14" />
</ResourceDictionary>
