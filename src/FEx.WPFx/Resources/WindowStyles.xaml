<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpfx="clr-namespace:FEx.WPFx"
                    xmlns:converters="clr-namespace:FEx.WPFx.Converters">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/FEx.WPFx;component/Resources/ColorsAndBrushes.xaml" />
        <ResourceDictionary Source="/FEx.WPFx;component/ConvertersDictionary.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="MessageWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="SingleBorderWindow" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>

    <Style x:Key="MessageShowInTaskbarWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="SingleBorderWindow" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="True" />
    </Style>

    <Style x:Key="VerticallyFitResizeableMessageWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="SingleBorderWindow" />
        <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>

    <Style x:Key="FixedSizeMessageWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="SingleBorderWindow" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>

    <Style x:Key="ResizeableMessageWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="SingleBorderWindow" />
        <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="ShowInTaskbar" Value="False" />
    </Style>

    <Style x:Key="ResizeableMessageShowInTaskbarWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="WindowStyle" Value="SingleBorderWindow" />
        <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
        <Setter Property="ShowInTaskbar" Value="True" />
    </Style>

    <!--  Start chrome window styles  -->

    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:ResizeModeToVisibilityConverter x:Key="ResizeModeToVisibilityConverter" />

    <Style x:Key="WindowButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource WindowChrome.ForegroundBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="contentPresenter"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource WindowChrome.MouseOverButtonBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource WindowChrome.IsPressedButtonBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="contentPresenter" Property="Opacity" Value=".5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BaseWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CornerRadius="0"
                              GlassFrameThickness="1"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModelessDialogWindowStyle"
           BasedOn="{StaticResource BaseWindowStyle}"
           TargetType="{x:Type Window}">
        <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
        <Setter Property="ShowInTaskbar" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <Border x:Name="WindowBorder"
                            Margin="{Binding Source={x:Static SystemParameters.WindowNonClientFrameThickness}}"
                            Background="{DynamicResource WindowChrome.BackgroundBrush}">
                        <Grid>
                            <Border x:Name="InnerBorder" BorderThickness="1">
                                <AdornerDecorator>
                                    <Grid x:Name="LayoutRoot">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="15" />
                                        </Grid.RowDefinitions>
                                        <Rectangle x:Name="HeaderBackground"
                                                   Grid.Row="0"
                                                   Fill="{DynamicResource WindowChrome.BackgroundBrush}"
                                                   Height="25"
                                                   VerticalAlignment="Top" />
                                        <StackPanel Grid.Row="0"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Top"
                                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                            <Button Style="{StaticResource WindowButtonStyle}"
                                                    ToolTip="{Binding Source={x:Static wpfx:FExWpfx.MinimizeString}}"
                                                    Visibility="{Binding ResizeMode,
                                                                         RelativeSource={RelativeSource FindAncestor,
                                                                                                        AncestorType={x:Type Window}},
                                                                         Converter={StaticResource ResizeModeToVisibilityConverter}}"
                                                    Command="{Binding Source={x:Static SystemCommands.MinimizeWindowCommand}}">
                                                <Button.Content>
                                                    <Grid Height="25"
                                                          RenderTransform="1,0,0,1,0,1"
                                                          Width="30">
                                                        <Path Data="M0,6 L8,6 Z"
                                                              Height="7"
                                                              HorizontalAlignment="Center"
                                                              Stroke="{Binding Foreground,
                                                                               RelativeSource={RelativeSource Mode=FindAncestor,
                                                                                                              AncestorType=Button}}"
                                                              StrokeThickness="2"
                                                              VerticalAlignment="Center"
                                                              Width="8" />
                                                    </Grid>
                                                </Button.Content>
                                            </Button>
                                            <Grid Margin="1,0,1,0">
                                                <Button x:Name="Restore"
                                                        Style="{StaticResource WindowButtonStyle}"
                                                        ToolTip="{Binding Source={x:Static wpfx:FExWpfx.RestoreString}}"
                                                        Visibility="{Binding ResizeMode,
                                                                             RelativeSource={RelativeSource FindAncestor,
                                                                                                            AncestorType={x:Type Window}},
                                                                             Converter={StaticResource ResizeModeToVisibilityConverter}}"
                                                        Command="{Binding Source={x:Static SystemCommands.RestoreWindowCommand}}">
                                                    <Button.Content>
                                                        <Grid Height="25"
                                                              RenderTransform="1,0,0,1,.5,.5"
                                                              UseLayoutRounding="True"
                                                              Width="30">
                                                            <Path Data="M2,0 L8,0 L8,6 M0,3 L6,3 M0,2 L6,2 L6,8 L0,8 Z"
                                                                  Height="8"
                                                                  HorizontalAlignment="Center"
                                                                  Stroke="{Binding Foreground,
                                                                                   RelativeSource={RelativeSource Mode=FindAncestor,
                                                                                                                  AncestorType=Button}}"
                                                                  StrokeThickness="1"
                                                                  VerticalAlignment="Center"
                                                                  Width="8" />
                                                        </Grid>
                                                    </Button.Content>
                                                </Button>
                                                <Button x:Name="Maximize"
                                                        Style="{StaticResource WindowButtonStyle}"
                                                        ToolTip="{Binding Source={x:Static wpfx:FExWpfx.MaximizeString}}"
                                                        Visibility="{Binding ResizeMode,
                                                                             RelativeSource={RelativeSource FindAncestor,
                                                                                                            AncestorType={x:Type Window}},
                                                                             Converter={StaticResource ResizeModeToVisibilityConverter}}"
                                                        Command="{Binding Source={x:Static SystemCommands.MaximizeWindowCommand}}">
                                                    <Button.Content>
                                                        <Grid Height="25" Width="31">
                                                            <Path Data="M0,1 L9,1 L9,8 L0,8 Z"
                                                                  Height="8"
                                                                  HorizontalAlignment="Center"
                                                                  Stroke="{Binding Foreground,
                                                                                   RelativeSource={RelativeSource Mode=FindAncestor,
                                                                                                                  AncestorType=Button}}"
                                                                  StrokeThickness="2"
                                                                  VerticalAlignment="Center"
                                                                  Width="9" />
                                                        </Grid>
                                                    </Button.Content>
                                                </Button>
                                            </Grid>
                                            <Button Style="{StaticResource WindowButtonStyle}"
                                                    ToolTip="{Binding Source={x:Static wpfx:FExWpfx.CloseString}}"
                                                    Command="{Binding Source={x:Static SystemCommands.CloseWindowCommand}}">
                                                <Button.Content>
                                                    <Grid Height="25"
                                                          RenderTransform="1,0,0,1,0,1"
                                                          Width="30">
                                                        <Path Data="M0,0 L8,7 M8,0 L0,7 Z"
                                                              Height="7"
                                                              HorizontalAlignment="Center"
                                                              Stroke="{Binding Foreground,
                                                                               RelativeSource={RelativeSource Mode=FindAncestor,
                                                                                                              AncestorType=Button}}"
                                                              StrokeThickness="1.5"
                                                              VerticalAlignment="Center"
                                                              Width="8" />
                                                    </Grid>
                                                </Button.Content>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Button x:Name="WindowIconButton"
                                                    Style="{StaticResource WindowButtonStyle}"
                                                    ToolTip="{Binding Source={x:Static wpfx:FExWpfx.ShowSystemMenuString}}"
                                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                                    Command="{Binding Source={x:Static SystemCommands.ShowSystemMenuCommand}}">
                                                <Button.Content>
                                                    <Image x:Name="WindowIconImage"
                                                           RenderOptions.BitmapScalingMode="Fant"
                                                           Source="{TemplateBinding Icon}" />
                                                </Button.Content>
                                            </Button>
                                            <TextBlock x:Name="WindowTitleTextBlock"
                                                       Margin="8,-1,0,0"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource WindowChrome.ForegroundBrush}"
                                                       HorizontalAlignment="Left"
                                                       TextOptions.TextFormattingMode="Display"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Text="{TemplateBinding Title}" />
                                        </StackPanel>
                                        <!--  The actual windows content goes here  -->
                                        <Border Grid.Row="1"
                                                Grid.RowSpan="2"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0">
                                            <ContentPresenter />
                                        </Border>
                                        <Grid Grid.Row="2">
                                            <Path x:Name="ResizeGrip"
                                                  Margin="1"
                                                  Data="F1 M1,10 L3,10 M5,10 L7,10 M9,10 L11,10 M2,9 L2,11 M6,9 L6,11 M10,9 L10,11 M5,6 L7,6 M9,6 L11,6 M6,5 L6,7 M10,5 L10,7 M9,2 L11,2 M10,1 L10,3"
                                                  Height="12"
                                                  HorizontalAlignment="Right"
                                                  Stretch="None"
                                                  Stroke="{DynamicResource WindowChrome.BorderBrush}"
                                                  StrokeThickness="1"
                                                  Visibility="Collapsed"
                                                  Width="12" />
                                        </Grid>
                                    </Grid>
                                </AdornerDecorator>
                            </Border>
                            <Border BorderBrush="{DynamicResource WindowChrome.BorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding IsActive,
                                                         RelativeSource={RelativeSource FindAncestor,
                                                                                        AncestorType={x:Type Window}},
                                                         Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="Maximize" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Restore" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LayoutRoot" Property="Margin" Value="7" />
                        </Trigger>
                        <Trigger Property="WindowState" Value="Normal">
                            <Setter TargetName="Maximize" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Restore" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ResizeMode" Value="CanResizeWithGrip" />
                                <Condition Property="WindowState" Value="Normal" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ResizeGrip" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ResizeMode" Value="NoResize" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Maximize" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Restore" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModalDialogWindowStyle"
           BasedOn="{StaticResource BaseWindowStyle}"
           TargetType="{x:Type Window}">
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <Border x:Name="WindowBorder"
                            Margin="{Binding Source={x:Static SystemParameters.WindowNonClientFrameThickness}}"
                            Background="{StaticResource WindowChrome.BackgroundBrush}">
                        <Grid>
                            <Border x:Name="InnerBorder" BorderThickness="1">
                                <AdornerDecorator>
                                    <Grid x:Name="LayoutRoot">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="25" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="15" />
                                        </Grid.RowDefinitions>
                                        <Rectangle x:Name="HeaderBackground"
                                                   Grid.Row="0"
                                                   Fill="{StaticResource WindowChrome.BackgroundBrush}"
                                                   Height="25"
                                                   VerticalAlignment="Top" />
                                        <StackPanel Grid.Row="0"
                                                    HorizontalAlignment="Right"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Top"
                                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                            <Button Style="{StaticResource WindowButtonStyle}"
                                                    ToolTip="{Binding Source={x:Static wpfx:FExWpfx.CloseString}}"
                                                    Command="{Binding Source={x:Static SystemCommands.CloseWindowCommand}}">
                                                <Button.Content>
                                                    <Grid Height="25"
                                                          RenderTransform="1,0,0,1,0,1"
                                                          Width="30">
                                                        <Path Data="M0,0 L8,7 M8,0 L0,7 Z"
                                                              Height="7"
                                                              HorizontalAlignment="Center"
                                                              Stroke="{Binding Foreground,
                                                                               RelativeSource={RelativeSource Mode=FindAncestor,
                                                                                                              AncestorType=Button}}"
                                                              StrokeThickness="1.5"
                                                              VerticalAlignment="Center"
                                                              Width="8" />
                                                    </Grid>
                                                </Button.Content>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Button x:Name="WindowIconButton"
                                                    Style="{StaticResource WindowButtonStyle}"
                                                    ToolTip="{Binding Source={x:Static wpfx:FExWpfx.ShowSystemMenuString}}"
                                                    WindowChrome.IsHitTestVisibleInChrome="True"
                                                    Command="{Binding Source={x:Static SystemCommands.ShowSystemMenuCommand}}">
                                                <Button.Content>
                                                    <Image x:Name="WindowIconImage"
                                                           RenderOptions.BitmapScalingMode="Fant"
                                                           Source="{TemplateBinding Icon}" />
                                                </Button.Content>
                                            </Button>
                                            <TextBlock x:Name="WindowTitleTextBlock"
                                                       Margin="8,-1,0,0"
                                                       FontSize="14"
                                                       Foreground="{StaticResource WindowChrome.ForegroundBrush}"
                                                       HorizontalAlignment="Left"
                                                       TextOptions.TextFormattingMode="Display"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Text="{TemplateBinding Title}" />
                                        </StackPanel>
                                        <!--  The actual windows content goes here  -->
                                        <Border Grid.Row="1"
                                                Grid.RowSpan="2"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="0">
                                            <ContentPresenter />
                                        </Border>
                                        <Grid Grid.Row="2">
                                            <Path x:Name="ResizeGrip"
                                                  Margin="1"
                                                  Data="F1 M1,10 L3,10 M5,10 L7,10 M9,10 L11,10 M2,9 L2,11 M6,9 L6,11 M10,9 L10,11 M5,6 L7,6 M9,6 L11,6 M6,5 L6,7 M10,5 L10,7 M9,2 L11,2 M10,1 L10,3"
                                                  Height="12"
                                                  HorizontalAlignment="Right"
                                                  Stretch="None"
                                                  Stroke="{StaticResource WindowChrome.BorderBrush}"
                                                  StrokeThickness="1"
                                                  Visibility="Collapsed"
                                                  Width="12" />
                                        </Grid>
                                    </Grid>
                                </AdornerDecorator>
                            </Border>
                            <Border BorderBrush="{StaticResource WindowChrome.BorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding IsActive,
                                                         RelativeSource={RelativeSource FindAncestor,
                                                                                        AncestorType={x:Type Window}},
                                                         Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ShellWindowStyle"
           BasedOn="{StaticResource ModelessDialogWindowStyle}"
           TargetType="{x:Type Window}" />

    <Style x:Key="ModalWindowStyle"
           BasedOn="{StaticResource ModalDialogWindowStyle}"
           TargetType="{x:Type Window}" />
    <!--  End window chrome window styles  -->
</ResourceDictionary>
