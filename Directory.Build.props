<Project>

    <PropertyGroup>
        <!-- Opt in to the DevConfigs NuGet package defaults (XML docs, embedded sources, symbol packages, SourceLink,
             license metadata). Must be set before the DevConfigs props import below. -->
        <DevConfigsPackageDefaults>true</DevConfigsPackageDefaults>
        <!-- Copies DevConfigs/.editorconfig to the repository root (gitignored) on every restore and build: an
             .editorconfig only governs the files beneath it, and the compiler and dotnet format read none other.
             Must be set before the DevConfigs props import below. -->
        <DevConfigsMirrorEditorConfig>true</DevConfigsMirrorEditorConfig>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)\DevConfigs\Directory.Build.props"/>

	<PropertyGroup>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<!-- Zero-warning policy: every build warning is promoted to an error so warnings cannot
		     accumulate. Genuine analyzer/platform false positives are suppressed at the call site
		     with a justification comment (or via a documented per-project NoWarn). -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- The Roslyn version FEx.Analyzers compiles against and its tests bring along; one number, so they cannot drift. -->
		<RoslynVersion>4.14.0</RoslynVersion>
		<!-- FEx builds the analyzer itself (Directory.Build.targets references the project). This opt-out is what stops the older
		     published FEx.Analyzers rules from running beside the ones at HEAD: without it restore adds the package next to the
		     project analyzer and both load. -->
		<DevConfigsFExAnalyzers>false</DevConfigsFExAnalyzers>
	</PropertyGroup>

</Project>