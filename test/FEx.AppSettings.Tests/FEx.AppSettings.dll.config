<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<add key="Legacy.Name" value="from-library-config-must-not-override" />
		<add key="Merged.Only" value="from-library-config" />
	</appSettings>
	<connectionStrings>
		<add name="Main" connectionString="Server=library;Database=must-not-override" />
		<add name="MergedOnly" connectionString="Server=library;Database=merged" />
	</connectionStrings>
</configuration>
