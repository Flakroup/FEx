<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(FullTargetFrameworkIds)</TargetFrameworks>
		<Description>SQL Server helper with instance discovery, connection extensions, and server property queries</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.79" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
        <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.25.0" />
        <!-- Security pin (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx): Microsoft.Data.SqlClient transitively pulls
             System.Security.Cryptography.Pkcs 8.0.1 / 9.0.18, which the advisories flag (fixed in 8.0.2 / 9.0.21 /
             10.0.13). Remove once Microsoft.Data.SqlClient pulls a patched version. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="$(DotNetNugetsVersion)" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == '$(TargetFrameworkId)'">
        <PackageReference Include="System.Management" Version="$(DotNetNugetsVersion)" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="FEx.Sqlx.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Agnostics\FEx.Agnostics.csproj" />
        <ProjectReference Include="..\Core\FEx.Core.csproj" />
        <ProjectReference Include="..\FEx.Asyncx\FEx.Asyncx.csproj" />
        <ProjectReference Include="..\Sqlx.Abstractions\FEx.Sqlx.Abstractions.csproj" />
    </ItemGroup>

</Project>
