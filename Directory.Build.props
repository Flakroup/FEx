<Project>

    <Import Project="$(MSBuildThisFileDirectory)\DevConfigs\Directory.Build.props"/>

	<PropertyGroup>
		<NoWarn>$(NoWarn);NU1701</NoWarn>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<!-- Zero-warning policy: every build warning is promoted to an error so warnings cannot
		     accumulate. Genuine analyzer/platform false positives are suppressed at the call site
		     with a justification comment (or via a documented per-project NoWarn). -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<!-- Security pin: SQLitePCLRaw.lib.e_sqlite3 2.x has known high-severity vulnerabilities
	     (GHSA-2m69-gcr7-jv3q). Pin globally to 3.50.3 (bundles SQLite 3.50.3) across all projects. -->
	<ItemGroup>
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
	</ItemGroup>

</Project>