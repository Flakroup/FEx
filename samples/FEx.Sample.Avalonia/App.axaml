<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FEx.Sample.Avalonia.App"
             RequestedThemeVariant="Light">
    <!-- Force Light theme for consistent demo appearance -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>

